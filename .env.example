# OBS WebSocket Configuration
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=your-obs-password

# Website WebSocket URL
WEBSITE_URL=ws://your-website.com/obs

# Optional: Unique identifier for this OBS client
CLIENT_ID=obs-client-1

# Authentication Token (required for server connection)
# Generate this token using the server API: POST /api/admin/instances/:id/token/generate
AUTH_TOKEN=your-auth-token-here
