<Window x:Class="OBSBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OBS Bridge" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="OBS Bridge" 
                          FontSize="20" FontWeight="Bold" 
                          Foreground="White" VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" Content="⚙ Settings" 
                       Click="SettingsButton_Click"
                       Background="#3E3E42" Foreground="White"
                       BorderBrush="#555" Padding="15,5"/>
            </Grid>
        </Border>

        <!-- Connection Status -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="15" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Connection Status" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- OBS Status -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Ellipse x:Name="ObsStatusIndicator" Width="12" Height="12" 
                                    Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ObsStatusText" Text="OBS Studio: Disconnected" 
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ObsVersionText" Text="" 
                                  FontSize="11" Foreground="Gray" Margin="20,0,0,0"/>
                    </StackPanel>

                    <!-- Website Status -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Ellipse x:Name="WebsiteStatusIndicator" Width="12" Height="12" 
                                    Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock x:Name="WebsiteStatusText" Text="Control Website: Disconnected" 
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Activity Log -->
        <Border Grid.Row="2" Padding="15" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Activity Log" FontSize="14" FontWeight="Bold"/>
                    <Button Grid.Column="1" Content="Clear" Click="ClearLogButton_Click" 
                           Padding="10,3" MinWidth="80"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="5,2" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" 
                                                  Text="{Binding FormattedTimestamp}" 
                                                  Foreground="Gray" FontSize="11"
                                                  VerticalAlignment="Top"/>
                                        
                                        <TextBlock Grid.Column="1" 
                                                  Text="{Binding Message}" 
                                                  Foreground="{Binding Color}"
                                                  TextWrapping="Wrap"
                                                  VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Control Buttons -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="15" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <CheckBox x:Name="AutoConnectCheckBox" 
                             Content="Auto-connect on startup" 
                             VerticalAlignment="Center"
                             Checked="AutoConnectCheckBox_Changed"
                             Unchecked="AutoConnectCheckBox_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="Start Bridge" 
                           Click="StartButton_Click"
                           Background="#0E7C0E" Foreground="White"
                           BorderBrush="#0D6D0D" Padding="20,8" MinWidth="120"/>
                    
                    <Button x:Name="StopButton" Content="Stop" 
                           Click="StopButton_Click"
                           Background="#D13438" Foreground="White"
                           BorderBrush="#B82D31" Padding="20,8" MinWidth="120"
                           IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
