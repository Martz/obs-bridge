<Window x:Class="OBSBridge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - OBS Bridge" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- OBS Settings Section -->
                <Border Background="#F5F5F5" Padding="15" CornerRadius="5" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="OBS Studio Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Label Content="Host:" FontWeight="SemiBold"/>
                        <TextBox x:Name="ObsHostTextBox" />
                        <TextBlock Text="Usually 'localhost' if OBS is running on this computer" 
                                  FontSize="11" Foreground="Gray" Margin="5,0,0,10"/>

                        <Label Content="Port:" FontWeight="SemiBold"/>
                        <TextBox x:Name="ObsPortTextBox" />
                        <TextBlock Text="Default is 4455 (check OBS WebSocket settings)" 
                                  FontSize="11" Foreground="Gray" Margin="5,0,0,10"/>

                        <Label Content="Password:" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="ObsPasswordBox" />
                        <TextBlock Text="The password set in OBS WebSocket settings" 
                                  FontSize="11" Foreground="Gray" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Website Settings Section -->
                <Border Background="#F5F5F5" Padding="15" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Control Website Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Label Content="Website URL:" FontWeight="SemiBold"/>
                        <TextBox x:Name="WebsiteUrlTextBox" />
                        <TextBlock Text="WebSocket URL (e.g., ws://example.com/obs or wss://example.com/obs)" 
                                  FontSize="11" Foreground="Gray" Margin="5,0,0,10"/>

                        <Label Content="Client ID:" FontWeight="SemiBold"/>
                        <TextBox x:Name="ClientIdTextBox" />
                        <TextBlock Text="Unique identifier for this OBS instance" 
                                  FontSize="11" Foreground="Gray" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Error Messages -->
                <TextBlock x:Name="ErrorTextBlock" 
                          Text="" 
                          Foreground="Red" 
                          TextWrapping="Wrap"
                          Margin="0,15,0,0"
                          Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="15" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelButton_Click" 
                       Padding="20,8" MinWidth="100" Margin="0,0,10,0"/>
                <Button Content="Save" Click="SaveButton_Click" 
                       Background="#0E7C0E" Foreground="White"
                       BorderBrush="#0D6D0D" Padding="20,8" MinWidth="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
